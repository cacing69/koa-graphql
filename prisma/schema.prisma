// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/shared/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(ulid()) @map("user_id") @db.VarChar(26)
  firstName String  @map("user_first_name") @db.VarChar(255)
  lastName  String? @map("user_last_name") @db.VarChar(255)
  email     String  @unique @map("user_email") @db.VarChar(255)
  password  String  @map("user_password") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("user_created_at")
  updatedAt DateTime? @map("user_updated_at")
  deletedAt DateTime? @map("user_deleted_at")
  createdBy String?   @map("user_created_by") @db.VarChar(26)
  updatedBy String?   @map("user_updated_by") @db.VarChar(26)
  deletedBy String?   @map("user_deleted_by") @db.VarChar(26)

  userPermissions UserPermission[]

  @@map("users")
}

model Role {
  id          String  @id @default(ulid()) @map("role_id") @db.VarChar(26)
  name        String  @map("role_name") @db.VarChar(255)
  displayName String? @map("role_display_name") @db.VarChar(255)
  description String? @map("role_description") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("role_created_at")
  updatedAt DateTime? @map("role_updated_at")
  deletedAt DateTime? @map("role_deleted_at")
  createdBy String?   @map("role_created_by") @db.VarChar(26)
  updatedBy String?   @map("role_updated_by") @db.VarChar(26)
  deletedBy String?   @map("role_deleted_by") @db.VarChar(26)

  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(ulid()) @map("permission_id") @db.VarChar(26)
  name        String  @map("permission_name") @db.VarChar(255)
  displayName String? @map("permission_display_name") @db.VarChar(255)
  description String? @map("permission_description") @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("permission_created_at")
  updatedAt DateTime? @map("permission_updated_at")
  deletedAt DateTime? @map("permission_deleted_at")
  createdBy String?   @map("permission_created_by") @db.VarChar(26)
  updatedBy String?   @map("permission_updated_by") @db.VarChar(26)
  deletedBy String?   @map("permission_deleted_by") @db.VarChar(26)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(ulid()) @map("role_permission_id") @db.VarChar(26)
  roleId       String @map("role_permission_role_id") @db.VarChar(26)
  permissionId String @map("role_permission_permission_id") @db.VarChar(26)

  createdAt DateTime  @default(now()) @map("role_permission_created_at")
  updatedAt DateTime? @map("role_permission_updated_at")
  deletedAt DateTime? @map("role_permission_deleted_at")
  createdBy String?   @map("role_permission_created_by") @db.VarChar(26)
  updatedBy String?   @map("role_permission_updated_by") @db.VarChar(26)
  deletedBy String?   @map("role_permission_deleted_by") @db.VarChar(26)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@map("role_permissions")
}

model UserPermission {
  id           String @id @default(ulid()) @map("user_permission_id") @db.VarChar(26)
  userId       String @map("user_permission_user_id") @db.VarChar(26)
  permissionId String @map("user_permission_permission_id") @db.VarChar(26)

  createdAt DateTime  @default(now()) @map("user_permission_created_at")
  updatedAt DateTime? @map("user_permission_updated_at")
  deletedAt DateTime? @map("user_permission_deleted_at")
  createdBy String?   @map("user_permission_created_by") @db.VarChar(26)
  updatedBy String?   @map("user_permission_updated_by") @db.VarChar(26)
  deletedBy String?   @map("user_permission_deleted_by") @db.VarChar(26)

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@map("user_permissions")
}

model Post {
  id      String  @id @default(ulid()) @db.VarChar(26)
  title   String  @db.VarChar(255)
  content String? @db.Text

  createdAt DateTime  @default(now()) @map("post_created_at")
  updatedAt DateTime? @map("post_updated_at")
  deletedAt DateTime? @map("post_deleted_at")
  createdBy String?   @map("post_created_by") @db.VarChar(26)
  updatedBy String?   @map("post_updated_by") @db.VarChar(26)
  deletedBy String?   @map("post_deleted_by") @db.VarChar(26)

  @@map("posts")
}
